.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~

# ─── IDE & EDİTÖR ────────────────────────────────────────────────
# VS Code (proje ayarları takip edilebilir, kişisel geçmiş edilemez)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/
*.vsix

# JetBrains (PyCharm, vb.)
.idea/
*.iml
*.iws
.idea_modules/

# Vim / Neovim / Emacs
*.swp
*.swo
*~
\#*\#
.#*
Session.vim
.netrwhist

# Sublime Text
*.sublime-project
*.sublime-workspace

# ─── GEÇİCİ / ÖNBELLEK ───────────────────────────────────────────
*.tmp
*.temp
*.bak
*.orig
*.cache
.cache/
tmp/
temp/
scratch/

# ─── NOT: TAKİP EDİLMESİ GEREKEN DOSYALAR ───────────────────────
# Aşağıdakiler KESİNLİKLE repoda olmalı, yoksaymayın:
#   *.skill          — Claude skill paketleri (ürünün kendisi)
#   *.md             — Tüm Markdown belgeler (docs, prompts, templates)
#   *.py             — Python kaynak kodu (engine/)
#   *.json           — Skill evals, n8n workflow şemaları, data dosyaları
#   *.txt            — Stopword listeleri, küçük örnek corpus
#   requirements.txt — Python bağımlılıkları
#   pyproject.toml   — Proje yapılandırması
#   Makefile         — Otomasyon görevleri
#   LICENSE          — Lisans dosyası
